{
  "expo": {
    "name": "proximity",
    "slug": "proximity",
    "scheme": "proximity",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAFAFB"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.makeitclaire.proximity",
      "buildNumber": "1",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Proximity needs access to your photos to set a profile picture.",
        "NSCameraUsageDescription": "Proximity needs camera access to take a profile photo."
      }
    },
    "android": {
      "package": "com.makeitclaire.proximity",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FAFAFB"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "3c878fa1-a0da-4a3f-bd6e-d64ac7aaa17e"
      }
    },
    "owner": "proximity123"
  }
}
